NEXT_PUBLIC_API_URL=https://api.lsjcollections.com/api
NEXT_PUBLIC_CDN_URL=https://lsjcollections.com/panels/admin
NEXT_PUBLIC_PHONEPE_ENV=UAT

# Sign-in is an email OTP handled entirely by the API — nothing to configure here.
# The backend's AUTH_BYPASS_OTP flag drives the dev code; the modal reads that
# from the request-otp response, so this flag is no longer required.
NEXT_PUBLIC_AUTH_BYPASS_OTP=false

# FALLBACK — Firebase phone OTP (lib/firebase.ts is commented out).
# Uncomment these only if you switch sign-in back to mobile numbers.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
