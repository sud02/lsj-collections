# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=https://lsjcollections.com
API_URL=https://api.lsjcollections.com

# Hostinger MySQL (existing database)
DB_HOST=srv1234.hstgr.io
DB_PORT=3306
DB_USER=u529052488_lsj
DB_PASSWORD=
DB_NAME=u529052488_lsj
DB_CONNECTION_LIMIT=10

# Development database (see scripts/clone-to-dev.js)
# Create a second database in Hostinger hPanel → Databases → MySQL Databases,
# then run: node scripts/clone-to-dev.js
# Once cloned, point DB_NAME/DB_USER/DB_PASSWORD above at it for local work so
# test sign-ups and orders never land in the live customer tables.
DEV_DB_NAME=
DEV_DB_USER=
DEV_DB_PASSWORD=
# DEV_DB_HOST=          # defaults to DB_HOST
# DEV_DB_PORT=          # defaults to DB_PORT

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=30d

# Auth — customers sign in with an email OTP (delivered by Resend).
# Codes are signed, not stored: OTP_SECRET (falls back to JWT_SECRET) signs them.
OTP_SECRET=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Flip AUTH_BYPASS_OTP=true to skip sending mail and accept a fixed code
# (useful for offline testing — never enable in production)
AUTH_BYPASS_OTP=false
AUTH_BYPASS_CODE=123456

# Optional: customer accounts on these addresses get role 'admin'
# (comma-separated; separate from ADMIN_EMAIL below, which is the support inbox)
ADMIN_LOGIN_EMAILS=

# FALLBACK — Firebase Admin SDK (phone OTP sign-in, currently commented out in
# auth.controller.js / auth.routes.js). Only needed if you switch back to it.
# FIREBASE_PROJECT_ID=lsj-app
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@lsj-app.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# PhonePe UAT (currently)
PHONEPE_MERCHANT_ID=LAKSHMISRINIUAT_25032115
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox

# PhonePe Production (after KYC approval)
# PHONEPE_MERCHANT_ID=
# PHONEPE_SALT_KEY=
# PHONEPE_BASE_URL=https://api.phonepe.com/apis/hermes

# Image/CDN base
CDN_URL=https://lsjcollections.com/panels/admin
# Later: CDN_URL=https://cdn.lsjcollections.com

# Email (Resend)
RESEND_API_KEY=re_
MAIL_FROM=orders@lsjcollections.com
MAIL_FROM_NAME=LSJ Collections
ADMIN_EMAIL=support@lsjcollections.com

# Admin default (for seed)
ADMIN_MOBILE=9876543210
